<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generates assets/js/lab-data.js: the SQL that EF Core 10 (SQL Server provider) really produces
       for each Lab scenario. No database needed: interceptors capture commands and suppress execution.
       Run from the repository root with: dotnet run, project tools/lab-sql (see README). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- Pin a patched version of a vulnerable transitive dependency (NU1902/NU1903) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
